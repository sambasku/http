docs {
DELETE /api/v1/chat/messages/:id - tombstone (author). Clear body/sticker/audio,
set deleted_at, insert chat_message_deletions, mirror.
}

meta {
  name: Delete Chat Message
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/chat/messages/{{chat_message_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

tests {
  test("200 + tombstone", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.body).to.equal(null);
    expect(res.body.data.deleted_at).to.not.equal(null);
  });
}
