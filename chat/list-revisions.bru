docs {
GET /api/v1/chat/messages/:id/revisions - riwayat suntingan dari Turso.
Bearer wajib.
}

meta {
  name: List Chat Revisions
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/chat/messages/{{chat_message_id}}/revisions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

tests {
  test("200 + revisions array", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
  });
}
