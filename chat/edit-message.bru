docs {
PATCH /api/v1/chat/messages/:id - sunting teks (author). Menulis revisi
body lama di Turso + mirror Supabase.
}

meta {
  name: Edit Chat Message
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/chat/messages/{{chat_message_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

body:json {
  {
    "body": "halo dari bruno chat (disunting)"
  }
}

tests {
  test("200 + edited_at set", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.body).to.equal("halo dari bruno chat (disunting)");
    expect(res.body.data.edited_at).to.not.equal(null);
  });
}
