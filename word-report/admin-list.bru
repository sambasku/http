docs {
Antrean laporan entri (admin/editor/root/reviewer).
Query: status=open|resolved, limit, cursor.
}

meta {
  name: Admin List Word Reports
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/word-reports?status=open&limit=20
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 list", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    if (res.body.data.length > 0) {
      bru.setVar("word_report_id", res.body.data[0].id);
    }
  });
}
