docs {
GET /api/v1/hot-topics - kartu Hot hari ini (G4/G5).
Publik, tanpa auth. Tiga tab dalam satu response: searched /
proposed / viewed. Limit 1-10 (default 10) per tab.
searched/proposed: jendela 24 jam + backfill 7 hari.
viewed: hari WIB ini + backfill 7 hari kalender.

200:

    {
      "success": true,
      "data": {
        "searched": {
          "items": [
            {
              "kind": "search_miss",
              "id": "01…",
              "term": "kwintal",
              "direction": "lemma",
              "hit_count": 3,
              "last_searched_at": "…",
              "in_window": true
            }
          ],
          "meta": { "in_window": 1, "backfilled": 0, "backfill_used": false }
        },
        "proposed": { "items": [], "meta": { "in_window": 0, "backfilled": 0, "backfill_used": false } },
        "viewed": { "items": [], "meta": { "in_window": 0, "backfilled": 0, "backfill_used": false } }
      }
    }

Dokumen: docs/api/58-api-hot-topics.md
}

meta {
  name: List Hot Topics
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/hot-topics?limit=10
  body: none
  auth: none
}

tests {
  test("200 + tiga tab + meta", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.have.property('searched');
    expect(res.body.data).to.have.property('proposed');
    expect(res.body.data).to.have.property('viewed');
    for (const tab of ['searched', 'proposed', 'viewed']) {
      expect(res.body.data[tab].items).to.be.an('array');
      expect(res.body.data[tab].items.length).to.be.at.most(10);
      expect(res.body.data[tab].meta).to.have.property('in_window');
      expect(res.body.data[tab].meta).to.have.property('backfilled');
      expect(res.body.data[tab].meta).to.have.property('backfill_used');
    }
  });
}
