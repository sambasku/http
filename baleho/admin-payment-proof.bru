meta {
  name: Admin get Baleho payment proof
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/admin/baleho/placements/{{balehoPlacementId}}/payment-proof
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Stream byte bukti bayar (root/admin saja). Response image/* + Cache-Control private, no-store.
  List admin tidak lagi mengembalikan payment_proof_url mentah - pakai endpoint ini.
}
