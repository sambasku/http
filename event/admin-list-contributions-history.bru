docs {
# GET /api/v1/admin/event-contributions?decided=1&q=
Riwayat usulan sudah diputus, opsional filter teks `q`.
}

tests {
  test("200 + items array", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.items).to.be.an('array');
  });
}
