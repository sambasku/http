meta {
  name: Admin List Events
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/events?limit=30
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_access_token}}
}

docs {
# GET /api/v1/admin/events
List semua status (root/admin/reviewer). Query sama dengan list publik
+ `status` (draft/published/archived).
}

tests {
  test("200 + items array", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.items).to.be.an('array');
  });
}
