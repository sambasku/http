meta {
  name: Admin List Event Contributions (pending)
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/admin/event-contributions?status=pending
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_access_token}}
}

docs {
# GET /api/v1/admin/event-contributions
Antrean usulan acara (root/admin/reviewer).

Query:
- `status` - pending | needs_revision | approved | rejected (default pending bila tanpa decided)
- `decided=1` - riwayat (approved|rejected|needs_revision); diabaikan bila status diisi
- `q` - cari nama / lokasi di payload (case-insensitive)
}

tests {
  test("200 + items array", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.items).to.be.an('array');
  });
}
