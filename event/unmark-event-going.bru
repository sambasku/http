meta {
  name: Unmark Event Going
  seq: 21
}

delete {
  url: {{baseUrl}}/api/v1/events/{{event_id}}/going
  body: none
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

docs {
# DELETE /api/v1/events/:id/going
Batal rencana datang (login). Idempotent. Activity event.going di-hide.
}

tests {
  test("200 + viewer_going false", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.viewer_going).to.equal(false);
  });
}

vars:pre-request {
  event_id: ganti-dengan-id-acara
}
