meta {
  name: Admin Cancel Event
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/admin/events/{{event_id}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_access_token}}
}

body:json {
{
  "cancelled": true
}
}

docs {
# POST /api/v1/admin/events/:id/cancel
Tandai acara dibatalkan (`cancelled_at` terisi). Kirim `{"cancelled": false}`
untuk memulihkan.

Status pelaksanaan lain (upcoming/ongoing/completed) diturunkan read-time -
hanya `cancelled_at` yang disimpan.
}

tests {
  test("200 + occurrence_status cancelled", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data.occurrence_status).to.equal('cancelled');
    expect(res.body.data.cancelled_at).to.not.be.null;
  });
}

vars:pre-request {
  event_id: ganti-dengan-id-acara
}
