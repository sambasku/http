meta {
  name: Report Jinye
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/jinye/reports
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "target_type": "jinye",
    "target_id": "{{jinyeId}}",
    "reason_code": "spam",
    "note": null
  }
}
