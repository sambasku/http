docs {
Tarik Jinye dari feed (56-api-jinye.md). Wajib
admin/root/reviewer/editor. published -> taken_down;
event feed ikut disembunyikan (visibility read-time).
}

meta {
  name: Admin Takedown Jinye
  seq: 41
}

post {
  url: {{baseUrl}}/api/v1/admin/jinye/:id/takedown
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 taken_down", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("taken_down");
  });
}
