meta {
  name: Promote example
  type: http
  seq: 50
}

post {
  url: {{baseUrl}}/api/v1/jinye/{{jinyeId}}/promote-example
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "word_id": "{{wordId}}",
    "include_audio": true,
    "target_sentence": "Saya makan nasi"
  }
}
