docs {
Semua Jinye (semua status) untuk moderasi (56-api-jinye.md).
Query opsional: status, username. Wajib admin/root/reviewer/editor.
}

meta {
  name: Admin List Jinye
  seq: 40
}

get {
  url: {{baseUrl}}/api/v1/admin/jinye?limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

script:post-response {
  const items = res.body.data || [];
  if (items[0]) bru.setVar("admin_jinye_id", items[0].id);
}

tests {
  test("200 list all statuses", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
  });
}
