docs {
GET /api/v1/admin/achievements/:id/recipients - daftar penerima (award id untuk revoke).
}
meta {
  name: Admin List Recipients
  seq: 18
}
get {
  url: {{baseUrl}}/api/v1/admin/achievements/{{achievementId}}/recipients?limit=20
  body: none
  auth: bearer
}
auth:bearer {
  token: {{admin_token}}
}
tests {
  test("200 + items array", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data.items).to.be.an("array");
  });
}
