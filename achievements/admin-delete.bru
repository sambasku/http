Award yang sudah terlanjur tetap; scan berhenti.
}
meta {
  name: Admin Delete Achievement
  seq: 16
}
delete {
  url: {{baseUrl}}/api/v1/admin/achievements/{{achievementId}}
  body: none
  auth: bearer
}
