meta {
  name: Get Cuisine by Slug (public)
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/culinary/cuisines/{{cuisine_slug}}
  body: none
  auth: none
}

vars:pre-request {
  cuisine_slug: bubur-pedas-sambas
}

docs {
  # GET /api/v1/culinary/cuisines/:slug
  Detail kuliner published + `places[]` (tempat yang menyajikan) dalam satu
  query JOIN. Atribusi gambar dan sumber ikut apa adanya (verbatim).
}

tests {
  test("200 detail kuliner", function () {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.slug).to.equal(bru.getVar('cuisine_slug'));
  });
}
