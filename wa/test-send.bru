docs {
Kirim pesan uji WA: raw body template (placeholder tidak dirender).
Tetap masuk hitungan quota + log. 200 dengan sent=false jika gagal kirim
(env belum dikonfigurasi / quota habis).
}

meta {
  name: WA Test Send
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/admin/wa/test-send
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "phone": "{{wa_test_phone}}",
    "template_id": "{{wa_template_id}}"
  }
}

tests {
  test("200 + sent flag", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data.sent).to.be.a("boolean");
  });
}
