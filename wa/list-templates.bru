meta {
  name: List WA Templates
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/wa/templates
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + templates array", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(Array.isArray(res.body.data.templates)).to.equal(true);
  });
}
