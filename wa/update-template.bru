meta {
  name: Update WA Template
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/admin/wa/templates/{{wa_template_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "enabled": true
  }
}

tests {
  test("200 + template", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.template.event_key).to.be.a("string");
  });
}
