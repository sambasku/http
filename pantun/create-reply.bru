docs {
Balas pantun pembuka (50-api-pantun.md). Wajib login. Body sama dengan
create: 4 baris + pola rima. parent = pantun pembuka (id path param).
404 bila pantun pembuka tidak ada / tidak tayang.
}

meta {
  name: Create Pantun Reply
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/pantuns/{{pantun_id}}/replies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "lines": ["Buah kelapa di pohon", "Jatuh malam hari", "Bulan purnama tampil", "Terang benderang bumi"],
    "rhyme_scheme": "ABAB",
    "language": "id"
  }
}

tests {
  test("201 reply published", () => {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.parent_id).to.equal(bru.getVar("pantun_id"));
    expect(res.body.data.status).to.equal("published");
  });
}
