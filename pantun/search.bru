docs {
Cari pantun + balasan tayang (50-api-pantun.md). Tanpa auth.
FTS5 trigram: q >= 3 karakter pakai index + skor bm25, q < 3 karakter
jatuh ke LIKE. Hasil campur induk (parent_id null) dan balasan
(parent_id = id pantun pembuka). Mobile memakai parent_id untuk membuka
thread induk lalu auto-scroll ke balasan yang di-tap.

200 sukses:

    {
      "success": true,
      "data": [
        {
          "id": "01JD...",
          "user_id": "01JD...",
          "username": "budi",
          "display_name": "Budi",
          "avatar_url": null,
          "is_verifier": false,
          "parent_id": null,
          "language": "id",
          "theme_id": null,
          "rhyme_scheme": "ABAB",
          "lines": ["Pergi berjalan ke Sambas", "Membeli ikan di pasar", "Ikan segar murah harga", "Pulang membawa ceria"],
          "status": "published",
          "upvotes": 0,
          "downvotes": 0,
          "created_at": "2026-10-25T00:00:00.000Z",
          "updated_at": null
        }
      ],
      "meta": { "limit": 20, "q": "ikan" }
    }
}

meta {
  name: Search Pantuns
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/pantuns/search?q=ikan&limit=20
  body: none
  auth: none
}

script:post-response {
  const items = res.body.data || [];
  if (items[0]) bru.setVar("pantun_search_id", items[0].id);
}

tests {
  test("200 + envelope search + published only", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta.q).to.equal("ikan");
    for (const item of res.body.data) {
      expect(item.status).to.equal("published");
      expect(item.lines).to.have.lengthOf(4);
    }
  });
}
