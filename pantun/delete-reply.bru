docs {
Hapus balasan pantun sendiri (50-api-pantun.md). Wajib login.
Soft delete: status jadi deleted_by_author.
403 bila bukan penulis; 404 bila tidak ditemukan.
}

meta {
  name: Delete Pantun Reply
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/pantuns/replies/:reply_id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 deleted", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
