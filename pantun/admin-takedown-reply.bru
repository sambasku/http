docs {
Takedown balasan pantun (50-api-pantun.md). Wajib
admin/root/reviewer/editor. Balasan published -> taken_down.
}

meta {
  name: Admin Takedown Pantun Reply
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/admin/pantuns/replies/:id/takedown
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 taken down", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
