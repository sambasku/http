    "lat": 1.35,
    "lng": 109.25,
    "short_description": "Place uji dari Bruno.",
    "region_id": "sambas",
    "status": "published",
    "images": [
      {
        "url": "https://cdn.jsdelivr.net/gh/sambasku/images@main/assets/places/placeholder.webp",
        "is_main": true,
        "attribution": { "name": "SambasKu", "provider": "sambasku" }
      }
    ]
  }
}

docs {
  # POST /api/v1/admin/places
  Buat place. 409 SLUG_TAKEN bila slug bentrok.
