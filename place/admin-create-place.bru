meta {
  name: Admin Create Place
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/admin/places
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "slug": "tempat-uji-bruno",
