meta {
  name: Admin Place Views Totals
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/admin/places/views?days=30
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

docs {
  # GET /api/v1/admin/places/views?days=7|30
  Total pembaca unik per place sejak N hari terakhir. Tanpa `days` = semua waktu.
  Sumber kolom "Dilihat" di halaman Wisata console.
}
