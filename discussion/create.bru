docs {
Kirim diskusi (pending_review). Wajib login. Deskripsi (body) wajib;
link_url https opsional; images[] opsional (maks 4). Gambar staging
ImageKit; public_url masih null sampai approve.

200 sukses:

    {
      "success": true,
      "data": {
        "id": "01JD...",
        "status": "pending_review",
        "submitted_at": "2026-09-24T00:00:00.000Z"
      }
    }
}

meta {
  name: Create Discussion
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/discussions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "body": "Apa arti frasa ini dalam bahasa Sambas?",
    "link_url": "https://example.com/artikel",
    "images": []
  }
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar("discussion_id", res.body.data.id);
  }
}

tests {
  test("200 pending_review", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("pending_review");
    expect(res.body.data.id).to.be.a("string");
  });
}
