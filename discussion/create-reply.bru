docs {
Balas diskusi yang sudah published. Login. Body 1..500. Blocklist
diterapkan seperti komentar. 409 DISCUSSION_NOT_PUBLISHED jika
help belum tayang.
}

meta {
  name: Create Reply
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/discussions/{{discussion_id}}/replies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "body": "Artinya kurang lebih seperti ini."
  }
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar("discussion_reply_id", res.body.data.id);
  }
}

tests {
  test("201 reply published", () => {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("published");
    expect(res.body.data.body).to.be.a("string");
    expect(res.body.data).to.have.property("avatar_url");
    expect(res.body.data).to.have.property("is_verifier");
    expect(res.body.data).to.have.property("is_pinned");
  });
}
