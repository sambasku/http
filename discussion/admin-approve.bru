docs {
Approve pending → published. Promote gambar ImageKit → GitHub; hapus
staging. Body JSON kosong atau multipart file / file_0… (bytes tersensor).
}

meta {
  name: Admin Approve
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/admin/discussions/{{discussion_id}}/approve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {}
}

tests {
  test("200 published", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("published");
  });
}
