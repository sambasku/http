docs {
Submit kata anonim DENGAN header X-Device-Id (varian per-device dari
Submit Word (Anonim)). Mobile/web mengirim id opaque stabil (8-64
karakter) pada header ini.

Dual-bucket tamu: 10 submit/jam per X-Device-Id + 20/jam per IP.
Mute sementara per IP/device → 403 ANON_CONTRIBUTION_MUTED.

201 sukses → bentuk sama dengan Submit Word (Anonim); 429 bila bucket
device ATAU IP penuh (Retry-After disertakan).
}
meta {
  name: Submit Word (Anonim, per-device)
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/contributions/words
  body: json
  auth: none
}

headers {
  X-Device-Id: {{device_id}}
}

body:json {
  {
    "language_id": "{{sambas_language_id}}",
    "lemma": "roboi",
    "meanings": [
      {
        "word_class_id": "{{word_class_id}}",
        "definition": "Istilah yang diusulkan pengunjung anonim",
        "order_index": 1,
        "translations": [
          {
            "language_id": "{{indonesia_language_id}}",
            "translation_text": "usulan anonim",
            "translation_type": "direct"
          }
        ]
      }
    ],
    "word_type": "word",
    "category_ids": [],
    "related_words": []
  }
}

script:pre-request {
  // device id contoh (ULID) - di app asli digenerate sekali & disimpan
  // flutter_secure_storage/shared_preferences, lihat docs/mobile/01
  bru.setVar('device_id', '01DEVBRUNODEVICEID000000000');
}

tests {
  test("201 + pending_review (bucket device 10/jam belum penuh)", () => {
    expect(res.status).to.equal(201);
    expect(res.body.data.status).to.equal('pending_review');
    expect(res.body.data.is_verified).to.equal(false);
  });
}
