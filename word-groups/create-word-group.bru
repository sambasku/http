meta {
  name: Create Word Group
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/word-groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Nama kelompok makna",
    "description": "Kelompok kata bermakna sama/berdekatan"
  }
}

docs {
# POST /api/v1/word-groups
Buat kelompok makna. Moderasi (PRD relasi-lemma, status-baru): verifikator
(admin/editor/root/reviewer) + body.status=published (default) → langsung
tayang, is_verified=true; contributor → pending_review (antrean review).
200 sukses dengan data kelompok; 400 VALIDATION_ERROR bila name kosong/lebih 120 karakter.
}

tests {
  test("status 200 + kelompok terbentuk", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.have.property("id");
    expect(res.body.data.members).to.be.an("array");
    bru_handlers["word_group_id"] = res.body.data.id;
  });
}
