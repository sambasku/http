docs {
Daftar inbox notifikasi milik user login (23-api-notifications.md).
Cursor pagination: limit 1-100 (default 20), cursor = id item terakhir,
urutan terbaru duluan. Login wajib.

type contoh: contribution_approved | word_comment | campaign | ...
target_kind: contribution | suggestion | word | discussion | campaign.
Tap word (termasuk word_comment) → detail kata di mobile.

200 sukses:

    {
      "success": true,
      "data": [
        {
          "id": "01J...",
          "type": "contribution_approved",
          "title": "Usulan disetujui",
          "body": "Usulan kata Anda telah disetujui dan dipublikasikan.",
          "target_kind": "contribution",
          "target_id": "01J...",
          "read_at": null,
          "created_at": "2026-09-21T00:00:00.000Z"
        }
      ],
      "meta": { "limit": 20, "next_cursor": null, "has_more": false }
    }

401 tanpa token.
}

meta {
  name: List Notifications
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/notifications?limit=20
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

tests {
  test("200 + list notifikasi dengan meta cursor", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta.has_more).to.be.a("boolean");
  });
}
