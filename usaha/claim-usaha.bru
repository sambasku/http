meta {
  name: Claim Usaha
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/usaha/{{usaha_slug}}/claims
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "evidence_images": [
      {
        "url": "https://ik.imagekit.io/test/usaha-claims/bukti-toko.jpg",
        "provider_file_id": "file_usaha_claim_1"
      }
    ],
    "note": "Foto toko dan SS WhatsApp atas nama saya."
  }
}

docs {
# POST /api/v1/usaha/:slug/claims
Ajukan klaim pengelolaan (wajib login). Body wajib `evidence_images` (1-5)
dengan `url` + `provider_file_id` ImageKit folder `/usaha-claims`.
Bukti TIDAK pernah diserialkan di endpoint publik - hanya admin.
Satu klaim `pending` per `(usaha_id, user_id)`.
}

tests {
  test("200 + pending", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal('pending');
  });
}

script:post-response {
  if (res.body?.data?.id) bru.setVar('usaha_claim_id', res.body.data.id);
}

vars:pre-request {
  usaha_slug: ganti-dengan-slug-usaha
}
