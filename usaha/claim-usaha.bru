meta {
  name: Claim Usaha
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/usaha/{{usaha_slug}}/claims
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "contact_evidence": "WhatsApp 081234567890 atas nama saya, IG @warungbruno",
    "note": "Saya pemilik warung ini sejak 2019."
  }
}

docs {
# POST /api/v1/usaha/:slug/claims
Ajukan klaim pengelolaan (wajib login). `contact_evidence` min 5 karakter.
Bukti TIDAK pernah diserialkan di endpoint publik - hanya admin.
Satu klaim `pending` per `(usaha_id, user_id)`.
}

tests {
  test("200 + pending", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal('pending');
  });
}

script:post-response {
  if (res.body?.data?.id) bru.setVar('usaha_claim_id', res.body.data.id);
}

vars:pre-request {
  usaha_slug: ganti-dengan-slug-usaha
}
