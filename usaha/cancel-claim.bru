meta {
  name: Cancel Usaha Claim
  seq: 11
}

delete {
  url: {{baseUrl}}/api/v1/usaha/claims/{{usaha_claim_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
# DELETE /api/v1/usaha/claims/:id
Batalkan klaim saat masih `pending`. Status jadi `cancelled`.
409 kalau sudah ditinjau admin.
}

tests {
  test("200 + data null", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

vars:pre-request {
  usaha_claim_id: ganti-dengan-id-klaim
}
