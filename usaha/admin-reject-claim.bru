meta {
  name: Admin Reject Claim
  seq: 31
}

post {
  url: {{baseUrl}}/api/v1/admin/usaha-claims/{{usaha_claim_id}}/reject
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_access_token}}
}

body:json {
  {
    "reason_code": "evidence_insufficient",
    "reason_text": "Bukti kontak belum cocok dengan pengelola usaha ini."
  }
}

docs {
# POST /api/v1/admin/usaha-claims/:id/reject
`reason_code` + `reason_text` (opsional). Pengaju dapat notifikasi
`usaha_claim_rejected`.
}

tests {
  test("200", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

vars:pre-request {
  usaha_claim_id: ganti-dengan-id-klaim
}
