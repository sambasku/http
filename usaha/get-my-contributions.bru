meta {
  name: Get My Usaha Contributions
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/usaha-contributions/mine
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
# GET /api/v1/usaha-contributions/mine
Usulan milik user login (default `kind=new`). Termasuk yang
`needs_revision`/`approved`/`rejected` beserta `revision_note` atau
`reject_reason_text`.
}

tests {
  test("200 + items array", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.items).to.be.an('array');
  });
}
