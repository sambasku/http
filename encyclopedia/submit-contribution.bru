meta {
  name: Submit Encyclopedia Contribution
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/encyclopedia/contributions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
{
  "kind": "new",
  "title": "Usulan Artikel Bruno",
  "excerpt": "",
  "body_md": "Isi artikel dari Bruno collection untuk uji usulan ensiklopedia.",
  "category_id": "sejarah",
  "tags": ["bruno"],
  "source_url": "https://example.com/sumber-bruno"
}
}

docs {
# POST /api/v1/encyclopedia/contributions
Kirim usulan artikel baru atau perbaikan. Wajib login.
`source_url` opsional, harus https.
}

tests {
  test("201 + status pending", () => {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal('pending');
  });
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setVar('encyclopedia_contribution_id', res.body.data.id);
  }
}
