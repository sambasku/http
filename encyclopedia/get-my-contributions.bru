meta {
  name: Get My Encyclopedia Contributions
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/encyclopedia/me/contributions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
# GET /api/v1/encyclopedia/me/contributions
Riwayat usulan artikel milik user login. Setiap item menyertakan `payload`.
}

tests {
  test("200 + list", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.have.property('items');
  });
}
