docs {
Upload foto place / wisata (GitHub → jsDelivr). Path assets/places/.
Boleh berkali-kali: tiap file jadi satu URL, lalu dikirim di images[] place.
}

meta {
  name: Upload Public Image (Place)
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/images?purpose=place
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:multipart-form {
  file: @file(/tmp/sambasku-place-sample.webp)
}

tests {
  test("201 github ATAU 503 belum dikonfigurasi", () => {
    expect([201, 503]).to.include(res.status);
    if (res.status === 201) {
      expect(res.body.data.url).to.contain('jsdelivr');
      expect(res.body.data.provider).to.equal('github');
      expect(res.body.data.provider_file_id).to.contain('places');
    } else {
      expect(res.body.error_code).to.equal('PUBLIC_IMAGE_UPLOAD_UNAVAILABLE');
    }
  });
}
