docs {
Feed sinyal abuse akun login (ugc_abuse_events) - hanya admin & root.
Urut terbaru dulu, cursor-based. Filter: signal, user_name (partial).
Detail: docs/api/38-api-admin-abuse.md.

200 sukses:

    {
      "success": true,
      "data": [
        {
          "id": "01J...",
          "user_id": "01J...",
          "username": "budi",
          "user_can_contribute": true,
          "user_muted_until": "2026-09-29T07:00:00.000Z",
          "signal": "input_rejected",
          "weight": 1,
          "entity_type": "comment",
          "entity_id": null,
          "meta": null,
          "created_at": "2026-09-29T06:00:00.000Z"
        }
      ],
      "meta": { "limit": 20, "next_cursor": null, "has_more": false }
    }
}

meta {
  name: List User Abuse Events
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/abuse/user-events?limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + array data + meta cursor", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.property("has_more");
  });
}
