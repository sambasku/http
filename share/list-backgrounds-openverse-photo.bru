docs {
Foto stok Openverse: provider=openverse&media=photo.
Lisensi hanya cc0,pdm,by (BY-SA/BY-NC dibuang).
Tiap item membawa license (mis. "CC BY 2.0"), license_url, source (mis. "flickr")
untuk kredit CC wajib di UI + PNG kartu share.
}

meta {
  name: List Share Backgrounds - Openverse photo
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/share/backgrounds?q=makan%20makanan&page=1&provider=openverse&media=photo
  body: none
  auth: none
}

tests {
  test("200 openverse photo", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.provider).to.equal('openverse');
    expect(res.body.data.media).to.equal('photo');
    for (const item of res.body.data.items) {
      expect(item.license).to.match(/^(CC BY |CC0|Public Domain Mark)/);
    }
  });
}
