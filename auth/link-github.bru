docs {
POST /api/v1/auth/github/link - hubungkan GitHub ke akun yang login.
Body: access_token ATAU code + redirect_uri (+ code_verifier PKCE).
}

meta {
  name: Link GitHub
  seq: 26
}

post {
  url: {{baseUrl}}/api/v1/auth/github/link
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "access_token": "{{githubAccessToken}}"
  }
}

tests {
  test("200 / 409", () => {
    expect(res.status).to.be.oneOf([200, 401, 409, 503]);
  });
}
