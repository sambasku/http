docs {
Hapus akun dengan kode dari email, tanpa sesi aplikasi. Kode di body
ini placeholder, jadi koleksi mengharapkan 401. Untuk uji sungguhan,
isi email + kode yang baru dikirim Delete Account Request, dan
confirmation harus persis "HAPUS".

200 sukses:

    {
      "success": true,
      "data": { "message": "Akun dan data pribadi berhasil dihapus." }
    }

401 kode tidak valid:

    {
      "success": false,
      "error_code": "DELETION_CODE_INVALID",
      "message": "Kode tidak valid atau sudah kedaluwarsa",
      "details": null
    }
}

meta {
  name: Delete Account Confirm
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/auth/delete-account/confirm
  body: json
  auth: none
}

body:json {
  {
    "email": "tidak-ada@example.com",
    "code": "A4K-9M2",
    "confirmation": "HAPUS"
  }
}

tests {
  test("401 kode placeholder tidak menghapus akun", () => {
    expect(res.status).to.equal(401);
    expect(res.body.success).to.equal(false);
    expect(res.body.error_code).to.equal("DELETION_CODE_INVALID");
    expect(res.body.message).to.equal("Kode tidak valid atau sudah kedaluwarsa");
  });
}
