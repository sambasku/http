meta {
  name: Set Password
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/set-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "provider": "google",
    "id_token": "{{google_id_token}}",
    "new_password": "PasswordBaru123",
    "confirm_password": "PasswordBaru123"
  }
}

docs {
  Facebook: provider facebook + access_token.
  GitHub: provider github + access_token, atau code + redirect_uri + code_verifier.
  Hanya untuk akun OAuth dengan password_hash null. Sukses mencabut semua refresh token.
  Response data.login_with = email asli, atau username bila email sintetis.
}

tests {
  test("status 200, 400, 401, 404, 409, atau 429", () => {
    expect(res.status).to.be.oneOf([200, 400, 401, 404, 409, 429]);
  });
}
