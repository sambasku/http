meta {
  name: Reset Password
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{admin_email}}",
    "code": "A4K-9M2",
    "new_password": "Password123"
  }
}

tests {
  test("status 200 (atau 401 kalau kode placeholder/expired)", () => {
    expect([200, 401]).to.include(res.status);
  });
}
