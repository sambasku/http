docs {
DELETE /api/v1/auth/github/link - lepas tautan GitHub.
409 LAST_AUTH_METHOD jika OAuth-only tanpa password.
}

meta {
  name: Unlink GitHub
  seq: 27
}

delete {
  url: {{baseUrl}}/api/v1/auth/github/link
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 / 404 / 409", () => {
    expect(res.status).to.be.oneOf([200, 401, 404, 409]);
  });
}
