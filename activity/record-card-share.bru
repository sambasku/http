docs {
Catat share kartu kata yang sukses (37-api-activity-feed.md).
Login semua role. Dedupe user+kata 24 jam: panggilan kedua 200 recorded=false.
Muncul di feed sebagai kind card_share ("Membagikan kartu · {lemma}").
}

meta {
  name: Record Card Share
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/words/{{word_id}}/card-shares
  body: none
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

tests {
  test("201 tercatat ATAU 200 sudah tercatat ATAU 404", () => {
    expect([200, 201, 404]).to.include(res.status);
    if (res.status !== 404) {
      expect(res.body.success).to.equal(true);
      expect(res.body.data.recorded).to.equal(res.status === 201);
    }
  });
}
