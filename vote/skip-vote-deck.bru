docs {
Lewati kartu deck tanpa menulis vote. Idempoten.
Sejak 0101 deck per MAKNA: target = meaning_id, bukan word_id.
Makna hilang dari GET /votes/deck user ini. User lain tetap melihat.
200: { meaning_id, skipped: true }
404 VOTE_TARGET_NOT_FOUND jika makna tidak ada.
}

meta {
  name: Skip Vote Deck Meaning
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/votes/skips
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "meaning_id": "{{meaning_id}}"
  }
}

tests {
  test("status 200 atau 404", function() {
    expect([200, 404]).to.include(res.status);
  });
  test("skip tercatat", function() {
    if (res.status !== 200) return;
    expect(res.body.success).to.equal(true);
    expect(res.body.data.skipped).to.equal(true);
    expect(res.body.data.meaning_id).to.equal(bru.getEnvVar("meaning_id"));
  });
}
