meta {
  name: Get Vote Deck
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/votes/deck?limit=10&randomize=true
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  limit: 10
  randomize: true
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("envelope success + data array", function() {
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.property("has_more");
  });
  test("0101: tiap kartu = makna (id makna + word_id induk + order_index)", function() {
    if (!res.body.data.length) return;
    const card = res.body.data[0];
    expect(card).to.have.property("word_id");
    expect(card).to.have.property("order_index");
    expect(card.id).to.not.equal(card.word_id);
  });

  test("kelas kata per makna (word_class, null bila belum diisi)", function() {
    if (!res.body.data.length) return;
    const card = res.body.data[0];
    expect(card).to.have.property("word_class");
    if (card.word_class !== null) {
      expect(card.word_class).to.have.property("code");
      expect(card.word_class).to.have.property("name");
    }
  });
}
