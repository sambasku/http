docs {
Reset SEMUA vote dari satu client_id third-party.
First-party client dilindungi → 400.
}

meta {
  name: Admin Reset Votes By Client
  seq: 9
}

delete {
  url: {{baseUrl}}/api/v1/admin/votes/reset-by-client
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "client_id": "{{third_party_client_id}}"
  }
}

tests {
  test("200 reset ATAU 400 first-party / body invalid", () => {
    expect([200, 400]).to.include(res.status);
    if (res.status === 200) {
      expect(res.body.data.deleted_count).to.be.a("number");
    }
  });
}
