docs {
Reset SEMUA vote untuk satu target (anti-brigading).
}

meta {
  name: Admin Reset Target Votes
  seq: 8
}

delete {
  url: {{baseUrl}}/api/v1/admin/votes/reset-target
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "target_type": "word",
    "target_id": "{{word_id}}"
  }
}

tests {
  test("200 reset count", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.deleted_count).to.be.a("number");
  });
}
