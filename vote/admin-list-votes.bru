docs {
Daftar vote admin (cursor). Role root/admin/reviewer.
Disebut di 26-api-my-votes.md sebagai antrean admin.
}

meta {
  name: Admin List Votes
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admin/votes?limit=20
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 list + meta cursor", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.property("has_more");
    for (const v of res.body.data) {
      expect(v).to.have.property("voter_username");
      expect(v).to.have.property("voter_email");
      expect(v).to.have.property("voter_display_name");
      expect(v).to.have.property("voter_avatar_url");
    }
    if (res.body.data.length > 0) {
      bru.setVar("admin_vote_id", res.body.data[0].id);
    }
  });
}
