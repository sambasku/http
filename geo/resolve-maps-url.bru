docs {
POST /api/v1/geo/resolve-maps-url - ubah tautan Google Maps jadi lat/lng
di dalam Kabupaten Sambas. Publik, rate limit 20/menit per IP.
Tidak memakai Google Places API.

Body:

    { "url": "https://maps.app.goo.gl/..." }

200:

    {
      "success": true,
      "data": {
        "lat": 1.36,
        "lng": 109.3,
        "canonical_url": "https://www.google.com/maps/..."
      }
    }

400 error_code: MAPS_URL_INVALID | MAPS_URL_NO_COORDS |
MAPS_URL_OUT_OF_BOUNDS | MAPS_URL_RESOLVE_FAILED | VALIDATION_ERROR
}

meta {
  name: Resolve Maps URL
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/geo/resolve-maps-url
  body: json
  auth: none
}

body:json {
  {
    "url": "https://www.google.com/maps/place/Foo/@1.36,109.30,17z"
  }
}

tests {
  test("200 + koordinat Sambas", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.lat).to.be.closeTo(1.36, 0.001);
    expect(res.body.data.lng).to.be.closeTo(109.3, 0.001);
    expect(res.body.data.canonical_url).to.be.a('string');
  });
}
