docs {
Soft-delete kata blocklist (10-api-comment-blocklist.md).
Id hilang / sudah dihapus → 404.
}

meta {
  name: Admin Comment Blocklist Delete
  seq: 9
}

delete {
  url: {{baseUrl}}/api/v1/admin/comment-blocklist/{{blocklist_word_id}}
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 soft-delete ATAU 404", () => {
    expect([200, 404]).to.include(res.status);
    if (res.status === 200) {
      expect(res.body.success).to.equal(true);
    }
  });
}
