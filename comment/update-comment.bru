docs {
  Edit komentar oleh penulis sendiri (PATCH). Non-penulis / admin → 403.
  Audio tidak diganti. Body kosong hanya valid jika komentar punya audio.
}

meta {
  name: Update Comment
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/comments/{{comment_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

body:json {
  {
    "body": "teks setelah diedit"
  }
}

tests {
  test("200 + is_edited true", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.body).to.equal("teks setelah diedit");
    expect(res.body.data.is_edited).to.equal(true);
  });
}
