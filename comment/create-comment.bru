docs {
Tulis komentar pada lemma (09-api-comment.md). Login wajib. Langsung
published (post-moderation). Body melewati blocklist replacement.

Gate tulis: can_contribute / mute / is_active. Teks asal-asalan → 400
UGC_INPUT_REJECTED.

201 sukses:

    {
      "success": true,
      "data": {
        "id": "01J...",
        "word_id": "01J...",
        "user_id": "01J...",
        "username": "kontributor",
        "display_name": "Kontributor",
        "avatar_url": null,
        "is_verifier": false,
        "body": "Kata ini juga sering saya dengar di Sambas",
        "status": "published",
        "created_at": "2026-09-18T10:00:00.000Z"
      }
    }
}

meta {
  name: Create Comment
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/words/{{word_id}}/comments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

body:json {
  {
    "body": "Kata ini juga sering saya dengar di Sambas"
  }
}

vars:post-response {
  comment_id: res.body.data.id
}

tests {
  test("201 + published (langsung tayang)", () => {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("published");
    expect(res.body.data.word_id).to.equal(vars.word_id);
    expect(res.body.data).to.have.property("username");
    expect(res.body.data).to.have.property("display_name");
    expect(res.body.data).to.have.property("avatar_url");
    expect(res.body.data).to.have.property("is_verifier");
    expect(res.body.data.is_verifier).to.be.a("boolean");
  });
}
