docs {
  GET /api/v1/users/me/username-history - riwayat ganti username (privat pemilik).
  Auth Bearer wajib.
  items: old_username, new_username, changed_at, hold_until, can_reclaim.
}

meta {
  name: Get Username History
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/users/me/username-history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + items array", () => {
    expect(res.status).to.be.oneOf([200, 401]);
    if (res.status === 200) {
      expect(res.body.data.items).to.be.an("array");
    }
  });
}
