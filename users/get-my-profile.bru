docs {
  GET /api/v1/users/me - prefill editor profil (display_name, bio, region_id, village_id) + flag guide kontribusi + consent legal.
  Auth Bearer wajib.

  `requires_consent` (boolean, selalu ada): true bila user belum
  menyetujui terms/privacy versi aktif. Mobile memakai field ini sebagai
  sumber kebenaran untuk memunculkan sheet persetujuan (bukan flag sekali
  pakai dari response login). Lihat docs/api/44-api-consent-oauth.md.
}

meta {
  name: Get My Profile
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + display_name + bio", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data.username).to.be.a("string");
    expect(res.body.data.display_name).to.be.a("string");
    expect(res.body.data).to.have.property("bio");
    expect(res.body.data).to.have.property("region_id");
    expect(res.body.data).to.have.property("village_id");
    expect(res.body.data).to.have.property("has_read_contribution_guide");
    expect(res.body.data).to.have.property("requires_consent");
  });
}
