docs {
Detail usulan + diff current vs proposed.
}

meta {
  name: Admin Get Word Suggestion
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/admin/word-suggestions/{{suggestion_id}}
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 detail ATAU 404", () => {
    expect([200, 404]).to.include(res.status);
    if (res.status === 200) {
      expect(res.body.data.id).to.have.lengthOf(26);
      expect(res.body.data).to.have.property("proposed_changes");
    }
  });
}
