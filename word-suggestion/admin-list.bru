docs {
Antrean usulan perubahan kata (admin/root/reviewer).
}

meta {
  name: Admin List Word Suggestions
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/word-suggestions?status=pending&limit=20
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 list", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    if (res.body.data.length > 0) {
      bru.setVar("suggestion_id", res.body.data[0].id);
    }
  });
}
