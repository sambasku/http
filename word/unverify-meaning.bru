docs {
Cabut verifikasi satu makna (G1) + rollup lemma.
Pakai meaning_id dari detail kata.

200 sukses:

    {
      "success": true,
      "data": {
        "meaning_id": "...",
        "word_id": "...",
        "is_verified": false
      }
    }

409 belum terverifikasi; 404 makna tidak ada; 403 bukan verifikator.
}

meta {
  name: Unverify Meaning
  seq: 42
}

post {
  url: {{baseUrl}}/api/v1/admin/words/meanings/{{meaning_id}}/unverify
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + verifikasi makna dicabut", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.is_verified).to.equal(false);
    expect(res.body.data.meaning_id).to.be.a("string");
    expect(res.body.data.word_id).to.be.a("string");
  });
}
